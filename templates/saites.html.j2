{% extends "base.html.j2" %}
{% set active_page = "saites" %}
{% set assets_prefix = "" %}
{% from "_macros.html.j2" import pagehead, metric %}
{% macro pair_row(r) -%}
<li class="saites-pair-row" data-tone="{{ r.tone }}">
  <a class="saites-pair" href="politiki/{{ r.a_slug }}.html#{{ r.anchor }}">{{ r.a_name }} <span class="saites-pair-sep" aria-hidden="true">↔</span><span class="sr-only"> un </span> {{ r.b_name }}</a>
  <span class="saites-pair-count"><span class="saites-pair-n">{{ r.n }}</span> {{ r.n|lv_plural("saikne", "saiknes") }}</span>
  {%- if r.desc %}
  <p class="saites-pair-desc">{{ r.desc }}</p>
  {%- endif %}
  <span class="saites-pair-meta">
    {%- for ty in r.types %}<span class="badge {{ ty.badge }}">{{ ty.label }}{% if r.types|length > 1 %} {{ ty.n }}{% endif %}</span>{% endfor %}
    <time datetime="{{ r.last }}">{{ r.last|lv_date }}</time>
  </span>
</li>
{%- endmacro %}

{% macro place_row(p, group) -%}
<li class="places-row">
  <a class="places-name" href="vietas/{{ p.slug }}.html">{{ p.name }}</a>
  {%- if group == "saeima" %}
  <span class="places-kind">{{ (p.kind_label|replace("Saeimas ", ""))|capitalize }}</span>
  {%- endif %}
  <span class="places-n">{{ p.members|length }} {{ p.members|length|lv_plural("politiķis", "politiķi") }}</span>
</li>
{%- endmacro %}

{% block title %}Saites{% endblock %}

{% block content %}
<section class="pagehead-section">

  {% call pagehead("Politiķu savstarpējās saiknes", "Saites") %}
      {{ metric("Saiknes", metrics.total) }}
      {{ metric("Politiķi", metrics.politicians) }}
      {{ metric("Uzbrukumi", metrics.attacks) }}
  {%- endcall %}

  {#- Noklusējuma skats: servera HTML, strādā bez JS. Pilnais D3 tīkls zemāk
      ielādējas tikai pēc pogas (assets/ssv1.js). #}
  <div class="saites-overview">
    <p class="saites-intro">Saikne ir politiķa publisks izteikums par citu politiķi — uzbrukums, spriedze, atbalsts vai nostāju konflikts.
      {% if recorded %}{{ metrics.total }} {{ metrics.total|lv_plural("saikne", "saiknes") }} starp {{ politicians|length }} {{ politicians|length|lv_plural("politiķi", "politiķiem") }}, {{ metrics.total|lv_plural("reģistrēta", "reģistrētas") }} no {{ recorded[0]|lv_date }} līdz {{ recorded[1]|lv_date }}.{% endif %}
      Neaktīvie politiķi un komentētāji nav ieskaitīti.</p>

    <div class="saites-search">
      <label for="saites-search">Atrast politiķi</label>
      <div class="field"><input id="saites-search" class="field-input" type="search" list="saites-politicians" autocomplete="off" placeholder="Vārds vai uzvārds"></div>
      <datalist id="saites-politicians">
        {%- for name, slug in politicians %}
        <option value="{{ name }}" data-slug="{{ slug }}"></option>
        {%- endfor %}
      </datalist>
    </div>

    {#- Jaunākās saiknes (Saites v2, 2026-11-22): pirmā = lapas lielais moments,
        nākamās 4 kompaktas rindas. Datums = kad MĒS ierakstījām (created_at).
        Bez krāsainām nozīmītēm un sānu svītrām (operatora jautājums §2.4/§2.6). #}
    {%- if newest %}
    <section class="saites-newest" aria-labelledby="saites-newest-h">
      <h2 id="saites-newest-h" class="saites-h2">Jaunākās saiknes</h2>
      <ol class="saites-newest-list">
        {%- for r in newest %}
        <li class="saites-newest-row{% if loop.first %} saites-newest-lead{% endif %}">
          <a class="saites-newest-names" href="politiki/{{ r.a_slug }}.html#{{ r.anchor }}">{{ r.a_name }} <span class="saites-pair-sep" aria-hidden="true">↔</span><span class="sr-only"> un </span> {{ r.b_name }}</a>
          {%- if r.desc %}
          <p class="saites-newest-desc">{{ r.desc }}</p>
          {%- endif %}
          <span class="saites-newest-type">{{ r.type_label }}</span>
          <span class="saites-newest-date">ierakstīts <time datetime="{{ r.last }}">{{ r.last|lv_date }}</time></span>
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}

    {#- Partiju tabula (§1.4): četri veidi saskaitās līdz «Saiknes». Rinda pati
        ir vadīkla: atver savus pārus nākamajā rindā (assets/ssv1.js); bez JS
        pāri ir redzami. Vienlaikus atvērta viena partija. #}
    <section class="saites-by-party" aria-labelledby="saites-party-h">
      <h2 id="saites-party-h" class="saites-h2">Pa partijām</h2>
      <div class="saites-party-wrap">
      <table class="saites-party-table">
        <caption class="sr-only">Saiknes pa partijām: kopā un pa veidiem</caption>
        <thead>
          <tr>
            <th scope="col">Partija</th>
            <th scope="col" class="num">Saiknes</th>
            {%- for tt, long, short in party_cols %}
            <th scope="col" class="num"><span class="col-long">{{ long }}</span><abbr class="col-short" title="{{ long }}">{{ short }}</abbr></th>
            {%- endfor %}
          </tr>
        </thead>
        {%- for p in party_pairs %}
        <tbody class="saites-party" data-party="{{ p.party }}">
          <tr class="saites-party-row">
            <th scope="row"><button type="button" class="saites-party-toggle" aria-expanded="true" aria-controls="saites-pp-{{ loop.index }}"><span class="saites-party-name">{% for part in (p.party or "Bez partijas").split("/") %}{% if not loop.first %}/<wbr>{% endif %}{{ part }}{% endfor %}</span></button></th>
            <td class="num saites-party-count">{{ p.count }}</td>
            {%- for tt, long, short in party_cols %}
            <td class="num">{{ p.types.get(tt, 0) or "–" }}</td>
            {%- endfor %}
          </tr>
          <tr class="saites-party-pairs" id="saites-pp-{{ loop.index }}">
            <td colspan="{{ party_cols|length + 2 }}">
              <p class="saites-party-pairs-n">{{ p.pairs|length }} {{ p.pairs|length|lv_plural("pāris", "pāri") }}, jaunākie augšā</p>
              <ul class="saites-pairs">
                {%- for r in p.pairs[:12] %}{{ pair_row(r) }}{% endfor %}
              </ul>
              {%- if p.pairs|length > 12 %}
              <details class="saites-more">
                <summary>Rādīt vēl {{ p.pairs|length - 12 }} {{ (p.pairs|length - 12)|lv_plural("pāri", "pārus") }}</summary>
                <ul class="saites-pairs">
                  {%- for r in p.pairs[12:] %}{{ pair_row(r) }}{% endfor %}
                </ul>
              </details>
              {%- endif %}
            </td>
          </tr>
        </tbody>
        {%- endfor %}
      </table>
      </div>
      <p class="saites-party-note">Saikne starp divu partiju politiķiem skaitās abās partijās, tāpēc kolonnu kopsumma ir lielāka par {{ metrics.total }}.</p>
    </section>

    {#- Kopīgās vietas (Saites v2, 2. posms): neitrāls slānis, tikai fakti ar
        avotu. Vieta ir sarakstā tikai tad, ja vismaz divi izsekoti politiķi tajā
        bijuši vienlaikus. Kārtojums pēc nosaukuma, ne pēc skaita (nav rangs).
        Visa rinda ved uz vietas lapu; «Rādīt vēl» = tas pats <details> kā pāriem. #}
    {%- if place_groups %}
    <section class="saites-places" id="kopigas-vietas" aria-labelledby="saites-places-h">
      <h2 id="saites-places-h" class="saites-h2">Kopīgās vietas</h2>
      <p class="saites-places-intro">Saeimas komisijas un delegācijas, kurās vismaz divi izsekoti politiķi bijuši vienā laikā, un organizācijas, kurās vismaz divi norādījuši amatu viena gada deklarācijās. Tie ir fakti no Saeimas un amatpersonu deklarācijām, nevis saiknes.</p>
      {%- for g in place_groups %}
      <h3 class="saites-places-h3">{{ g.title }}</h3>
      {%- set rows = g.places %}
      <ul class="places-list">
        {%- for p in rows[:12] %}{{ place_row(p, g.key) }}{% endfor %}
      </ul>
      {%- if rows|length > 12 %}
      <details class="saites-more">
        <summary>Rādīt vēl {{ rows|length - 12 }} {{ (rows|length - 12)|lv_plural("vietu", "vietas") }}</summary>
        <ul class="places-list">
          {%- for p in rows[12:] %}{{ place_row(p, g.key) }}{% endfor %}
        </ul>
      </details>
      {%- endif %}
      {%- endfor %}
    </section>
    {%- endif %}

    {#- Tabula (dublēja spriedzes.html) izņemta 2026-10-18 — spriedzes.html ir
        tas pats saraksts ar tipa/partijas/personas filtriem URL adresē. #}
    <p class="saites-to-list-wrap"><a class="saites-to-list" href="spriedzes.html">Visu saikņu saraksts ar filtriem →</a></p>
  </div>

  {#- Pilnais tīkls: nekas no D3 neielādējas, kamēr lasītājs nenospiež pogu
      (assets/ssv1.js → d3 + sav1.js + data/saites-graph.json). #}
  <div class="saites-graph-open">
    <button type="button" id="saites-open-graph" class="saites-open-graph">Rādīt visu tīklu</button>
    <p id="saites-graph-status" class="saites-graph-status" role="status"></p>
  </div>

  <div id="saites-graph-block" class="saites-graph-block" hidden>
    <div id="link-filters" class="link-filters chip-row">
      {%- for lt in link_types %}
      <button class="chip link-filter-btn lt-{{ lt.cls }} active" aria-pressed="true" data-link-type="{{ lt.type }}">
        <span class="filter-dot chip-dot" aria-hidden="true"></span>
        {{ lt.label }} <span class="filter-count chip-n">{{ lt.count }}</span>
      </button>
      {%- endfor %}
    </div>

    <!-- Split layout: graph + detail panel -->
    <div class="graph-split">
      <div class="graph-pane" id="graph-container">
        <svg id="graph-svg"></svg>
      </div>
      <div class="detail-pane" id="detail-pane">
        <div class="detail-pane-empty" id="detail-empty">
          <span class="hint-icon">&#8644;</span>
          <p>Uzspied <strong>politiķi</strong> vai <strong>līniju</strong>, lai redzētu detaļas.</p>
        </div>
        <div id="detail-content" hidden></div>
      </div>
    </div>

    {#- Leģenda zem grafa, ne virs tā (agrāk position:absolute pārklāja grafu telefonā). #}
    <ul id="graph-legend" class="graph-legend">
      {%- for lt in link_types %}
      <li class="lt-{{ lt.cls }}"><span class="legend-line"></span>{{ lt.label }}</li>
      {%- endfor %}
      <li class="lt-vote-top"><span class="legend-line"></span>Visbiežāk balso vienādi</li>
      <li class="lt-vote-bottom"><span class="legend-line"></span>Visretāk balso vienādi</li>
      <li class="lt-pretrunas"><span class="legend-dot"></span>Pretrunas</li>
    </ul>
    {#- Partiju leģenda: mezgla krāsa = partija. Poga izceļ partijas mezglus
        (sav1.js); otrs spiediens noņem. Krāsa caur --pc (CSP style-src atļauj). #}
    <div class="graph-party-legend">
      <p class="graph-legend-title" id="graph-party-legend-h">Partijas (aplis)</p>
      <ul class="graph-party-list" aria-labelledby="graph-party-legend-h">
        {%- for gp in graph_parties %}
        <li><button type="button" class="graph-party-btn" data-party="{{ gp.party }}" aria-pressed="false"{% if gp.color %} style="--pc: {{ gp.color }}"{% endif %}><span class="graph-party-swatch" aria-hidden="true"></span>{{ gp.label }} <span class="graph-party-n">{{ gp.n }}</span></button></li>
        {%- endfor %}
      </ul>
    </div>
    <p class="graph-vote-note">Balsojumu līnijas parādās, kad izvēlies politiķi: 3 kolēģi, ar kuriem viņš Saeimā balso vienādi visbiežāk, un 3, ar kuriem visretāk (ja kopā ir vismaz {{ vote_min_shared }} balsojumu).</p>
  </div>

</section>
{% endblock %}

{% block scripts %}
<script type="application/json" id="saites-data">{{ saites_data | tojson | safe_json }}</script>
<script src="assets/ssv1.js?v={{ assets_version }}"></script>
{# d3.v7.min.js (pašmitināts kopš 2026-08-15) un sav1.js te vairs nav: ssv1.js
   tos ielādē secīgi tikai pēc pogas «Rādīt visu tīklu» (2026-10-18). #}
{% endblock %}
