{% extends "base.html.j2" %}
{% set active_page = "saeima" %}
{% set assets_prefix = "" %}
{% from "_macros.html.j2" import pagehead, metric %}

{% block title %}15. Saeima{% endblock %}
{% block description %}Visi 100 ievēlētie 15. Saeimas deputāti vienā puslokā: saraksts, balsojumi {{ vote_convocation }}. Saeimā, pozīcijas un pretrunas.{% endblock %}
{% block og_title %}15. Saeima — atmina.lv{% endblock %}
{% block og_description %}Visi 100 ievēlētie deputāti vienā puslokā — ko katrs saka un kā balsojis.{% endblock %}

{#- 15. Saeimas pusloks (src/render/saeima.py). Lēcu pārslēgšana = data-lens uz
    .slv saknes; krāsas un teksti pārslēdzas CSS (assets/style.css «Saeima
    pusloks»). Bez JS strādā «Saraksta» lēca, sēdvieta ved uz rindu sarakstā. -#}
{% macro dep_card(s) -%}
<div class="slv-card">
  <div class="slv-card-top">
    {% if s.has_photo %}<img class="slv-card-avatar" src="assets/photos/{{ s.slug }}.jpg" alt="" loading="lazy" decoding="async" width="48" height="48">{% else %}<div class="slv-card-avatar slv-card-avatar-ph" aria-hidden="true">{{ s.name[0]|upper }}</div>{% endif %}
    <div class="slv-card-ident">
      <div class="slv-card-eyebrow"><span class="slv-swatch" aria-hidden="true"></span>{{ s.list.short }}{% if s.region %} · {{ s.region }}{% endif %}</div>
      <div class="slv-card-name">{{ s.name }}</div>
      {% if s.office %}<div class="slv-office">{{ s.office }}</div>{% endif %}
    </div>
  </div>
  {%- if gov %}
  <dl class="slv-facts slv-facts-gov">
    <div class="slv-fact">
      <dt>Koalīcija vai opozīcija</dt>
      <dd>{{ s.gov_text }}</dd>
    </div>
    <div class="slv-fact">
      <dt>Uzticības balsojums {{ gov.date_short }}</dt>
      <dd>{{ s.uzt_text }}</dd>
    </div>
  </dl>
  {%- endif %}
  {% if s.tracked %}
  <dl class="slv-facts">
    <div class="slv-fact">
      <dt>Pozīcijas {{ window_days }} dienās</dt>
      <dd>{{ s.pos90 }}</dd>
    </div>
    <div class="slv-fact{% if s.ctr %} is-red{% endif %}">
      <dt>Pretrunas</dt>
      <dd>{% if s.ctr %}<a href="politiki/{{ s.slug }}.html#pretrunas">{{ s.ctr }}</a>{% else %}0{% endif %}</dd>
    </div>
    <div class="slv-fact">
      <dt>Balsoja {{ vote_convocation }}. Saeimā</dt>
      <dd>{% if s.voted14 %}jā{% else %}nē{% endif %}</dd>
    </div>
  </dl>
  {% if s.latest %}
  <div class="slv-latest">
    <div class="slv-latest-meta">Jaunākā pozīcija · {{ s.latest.date }}{% if s.latest.topic %} · {{ s.latest.topic }}{% endif %}</div>
    <p class="slv-latest-stance">{{ s.latest.stance }}</p>
    {% if s.latest.source_url %}<a class="slv-latest-src" href="{{ s.latest.source_url|safe_url }}" target="_blank" rel="noopener">Avots ↗</a>{% endif %}
  </div>
  {% else %}
  <p class="slv-card-note">Pozīciju vēl nav.</p>
  {% endif %}
  <a class="slv-card-cta" href="politiki/{{ s.slug }}.html">Pilnais profils →</a>
  {% else %}
  <p class="slv-card-note">Profils vēl nav izveidots.</p>
  {% endif %}
</div>
{%- endmacro %}

{% block content %}
<section class="pagehead-section slv" data-lens="saraksts" id="slv">
{% set slv_lead %}
      <p class="slv-lead">Visi {{ total }} ievēlētie deputāti vienā skatā. Pieskaries sēdvietai, lai redzētu pozīcijas, pretrunas un balsojumus.</p>
      <p class="slv-status">{% if provisional %}<span class="badge badge-yellow">Provizoriski — CVK aprēķins{% if updated_short %}, {{ updated_short }}{% endif %}</span>{% else %}<span>Oficiālie CVK rezultāti{% if updated_short %}, {{ updated_short }}{% endif %}</span>{% endif %} <a href="{{ source_url|safe_url }}" target="_blank" rel="noopener">CVK avots ↗</a></p>{% endset %}
  {% call pagehead("Saeimas sastāvs · 2026–2030", "15. Saeima", header_class="slv-head", lead=slv_lead) %}
      {{ metric("Deputāti", total) }}
      {{ metric("Saraksti", lists|length) }}
      {{ metric("Ar profilu", tracked_n) }}
  {%- endcall %}

  <div class="slv-lenses seg-ctl{% if gov %} has-gov{% endif %}" role="group" aria-label="Ko rāda krāsas" hidden>
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="saraksts" aria-pressed="true">Saraksts</button>
    {%- if gov %}
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="koalicija" aria-pressed="false">Koalīcija</button>
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="uzticiba" aria-pressed="false"><span class="slv-long">Uzticības balsojums</span><span class="slv-short">Uzticība</span></button>
    {%- endif %}
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="v14" aria-pressed="false"><span class="slv-long">Balsoja </span>{{ vote_convocation }}. Saeimā</button>
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="pozicijas" aria-pressed="false">Pozīcijas</button>
    <button type="button" class="seg-ctl-btn slv-lens" data-lens="pretrunas" aria-pressed="false">Pretrunas</button>
  </div>

  <div class="slv-stage">
    <div class="slv-chamber">
      <div class="slv-arc">
        <svg class="slv-svg" viewBox="-212 -212 424 222" role="group" aria-label="15. Saeimas sēdvietas pa sarakstiem">
          {%- for s in seats %}
          <a href="#dep-{{ s.slug }}" class="seat{% if s.ring %} has-office{% endif %}" data-slug="{{ s.slug }}" data-list="{{ s.list.nr }}" data-v14="{% if s.voted14 %}ja{% else %}ne{% endif %}" data-pos="{{ s.pos_bucket }}" data-ctr="{{ s.ctr_bucket }}"{% if gov %} data-gov="{{ s.gov }}" data-uzt="{{ s.uzt }}"{% endif %} aria-label="{{ s.name }}, {{ s.list.short }}{% if s.office %}, {{ s.office }}{% endif %}" style="--seat-list:{{ s.list.color }}"><title>{{ s.name }} · {{ s.list.short }}{% if s.office %} · {{ s.office }}{% endif %}</title><circle class="seat-hit" cx="{{ s.x }}" cy="{{ s.y }}" r="{{ hit_r }}"/><circle class="seat-dot" cx="{{ s.x }}" cy="{{ s.y }}" r="{{ dot_r }}"/>{% if s.ring %}<circle class="seat-ring" cx="{{ s.x }}" cy="{{ s.y }}" r="{{ ring_r }}"/>{% endif %}</a>
          {%- endfor %}
        </svg>
        <div class="slv-center" aria-hidden="true">
          <span class="slv-center-n">{{ total }}</span>
          <span class="slv-center-l">deputāti</span>
        </div>
      </div>

      <p class="slv-summary">
        <span data-lens-for="saraksts">{{ total }} deputāti no {{ lists|length }} sarakstiem</span>
        {%- if gov %}
        <span data-lens-for="koalicija">{{ gov.counts.koalicija }} no {{ total }} deputātiem ir valdības koalīcijā</span>
        <span data-lens-for="uzticiba">Uzticības balsojumā {{ gov.date_short }}: {{ gov.uzt_counts.par }} par, {{ gov.uzt_counts.pret }} pret{% if gov.uzt_counts.atturas %}, {{ gov.uzt_counts.atturas }} atturas{% endif %}</span>
        {%- endif %}
        <span data-lens-for="v14">{{ voted_n }} no {{ total }} balsoja arī {{ vote_convocation }}. Saeimā</span>
        <span data-lens-for="pozicijas">{{ pos_total_text }} {{ pos_total|lv_plural("pozīcija", "pozīcijas") }} pēdējās {{ window_days }} dienās</span>
        <span data-lens-for="pretrunas">{% if ctr_people %}{{ ctr_people }} {{ ctr_people|lv_plural("deputātam", "deputātiem") }} ir publicētas pretrunas{% else %}Publicētu pretrunu nav{% endif %}</span>
      </p>

      <div class="slv-legend" data-lens-for="saraksts">
        <ul class="slv-keys">
          {% for l in lists %}<li style="--seat-list:{{ l.color }}"><span class="slv-key slv-key-list" aria-hidden="true"></span>{{ l.short }} <span class="slv-key-n">{{ l.seats }}</span></li>{% endfor %}
        </ul>
        <p class="slv-legend-note">Krāsa — saraksts, no kura deputāts ievēlēts. Kārtība — pēc saņemto vietu skaita, ne pēc politiskā spektra. Dati par {{ total }} no {{ total }}.</p>
      </div>
      {%- if gov %}
      <div class="slv-legend" data-lens-for="koalicija">
        <ul class="slv-keys">
          <li><span class="slv-key slv-key-gov-k" aria-hidden="true"></span>koalīcija <span class="slv-key-n">{{ gov.counts.koalicija }}</span></li>
          <li><span class="slv-key slv-key-gov-o" aria-hidden="true"></span>opozīcija <span class="slv-key-n">{{ gov.counts.opozicija }}</span></li>
          {% if gov.counts.nav %}<li><span class="slv-key slv-key-nav" aria-hidden="true"></span>nav datu <span class="slv-key-n">{{ gov.counts.nav }}</span></li>{% endif %}
        </ul>
        <p class="slv-legend-note">Krāsa rāda, vai deputāta saraksta partija ir valdības koalīcijā. Valdībai uzticību Saeima izteica {{ gov.date }}{% if gov.coalition_text %}; koalīcijā ir {{ gov.coalition_text }}{% endif %}. Dati par {{ gov.known_n }} no {{ total }}. <a href="{{ gov.url|safe_url }}" target="_blank" rel="noopener">Balsojums ↗</a></p>
      </div>
      <div class="slv-legend" data-lens-for="uzticiba">
        <ul class="slv-keys">
          <li><span class="slv-key slv-key-uzt-par" aria-hidden="true"></span>par <span class="slv-key-n">{{ gov.uzt_counts.par }}</span></li>
          <li><span class="slv-key slv-key-uzt-pret" aria-hidden="true"></span>pret <span class="slv-key-n">{{ gov.uzt_counts.pret }}</span></li>
          {% if gov.uzt_counts.atturas %}<li><span class="slv-key slv-key-uzt-atturas" aria-hidden="true"></span>atturas <span class="slv-key-n">{{ gov.uzt_counts.atturas }}</span></li>{% endif %}
          <li><span class="slv-key slv-key-uzt-nebalsoja" aria-hidden="true"></span>nebalsoja <span class="slv-key-n">{{ gov.uzt_counts.nebalsoja }}</span></li>
          {% if gov.uzt_counts.nav %}<li><span class="slv-key slv-key-nav" aria-hidden="true"></span>nav ieraksta <span class="slv-key-n">{{ gov.uzt_counts.nav }}</span></li>{% endif %}
        </ul>
        <p class="slv-legend-note">Katra deputāta balss, kad Saeima {{ gov.date }} lēma par uzticību Ministru kabinetam. {% if mandates_n %}Puslokā ir pašreizējais sastāvs: {{ mandates_n }} {{ mandates_n|lv_plural("deputāts", "deputāti") }} ministru vietā toreiz vēl nebija Saeimā, tāpēc viņiem balss nav.{% endif %}{% if gov.uzt_counts.nav %} «Nav ieraksta»: mūsu balsojuma datos šim deputātam balss nav.{% endif %} Dati par {{ gov.rows_n }} no {{ total }}. <a href="{{ gov.url|safe_url }}" target="_blank" rel="noopener">Balsojums ↗</a></p>
      </div>
      {%- endif %}
      <div class="slv-legend" data-lens-for="v14">
        <ul class="slv-keys">
          <li><span class="slv-key slv-key-v14-ja" aria-hidden="true"></span>balsoja <span class="slv-key-n">{{ voted_n }}</span></li>
          <li><span class="slv-key slv-key-v14-ne" aria-hidden="true"></span>nebalsoja <span class="slv-key-n">{{ total - voted_n }}</span></li>
        </ul>
        <p class="slv-legend-note">Vai deputāts iepriekšējā, {{ vote_convocation }}. Saeimā ir balsojis vismaz vienu reizi. Ministrs, kurš nolika mandātu, balsojumos neparādās. Dati par {{ total }} no {{ total }}.</p>
      </div>
      <div class="slv-legend" data-lens-for="pozicijas">
        <ul class="slv-keys">
          <li><span class="slv-key slv-key-pos-0" aria-hidden="true"></span>0 <span class="slv-key-n">{{ pos_counts['0'] }}</span></li>
          <li><span class="slv-key slv-key-pos-1" aria-hidden="true"></span>1–4 <span class="slv-key-n">{{ pos_counts['1'] }}</span></li>
          <li><span class="slv-key slv-key-pos-5" aria-hidden="true"></span>5–19 <span class="slv-key-n">{{ pos_counts['5'] }}</span></li>
          <li><span class="slv-key slv-key-pos-20" aria-hidden="true"></span>20+ <span class="slv-key-n">{{ pos_counts['20'] }}</span></li>
          {% if pos_counts['nav'] %}<li><span class="slv-key slv-key-nav" aria-hidden="true"></span>nav datu <span class="slv-key-n">{{ pos_counts['nav'] }}</span></li>{% endif %}
        </ul>
        <p class="slv-legend-note">Publiski izteikumi, ko esam fiksējuši pēdējās {{ window_days }} dienās. Dati par {{ tracked_n }} no {{ total }}{% if untracked_n %} — {{ untracked_n }} {{ untracked_n|lv_plural("deputātam", "deputātiem") }} profila vēl nav{% endif %}.</p>
      </div>
      <div class="slv-legend" data-lens-for="pretrunas">
        <ul class="slv-keys">
          <li><span class="slv-key slv-key-ctr-0" aria-hidden="true"></span>0 <span class="slv-key-n">{{ ctr_counts['0'] }}</span></li>
          <li><span class="slv-key slv-key-ctr-1" aria-hidden="true"></span>1 <span class="slv-key-n">{{ ctr_counts['1'] }}</span></li>
          <li><span class="slv-key slv-key-ctr-2" aria-hidden="true"></span>2 un vairāk <span class="slv-key-n">{{ ctr_counts['2'] }}</span></li>
          {% if ctr_counts['nav'] %}<li><span class="slv-key slv-key-nav" aria-hidden="true"></span>nav datu <span class="slv-key-n">{{ ctr_counts['nav'] }}</span></li>{% endif %}
        </ul>
        <p class="slv-legend-note">Publicētās pretrunas — visā laikā, kopš sekojam deputātam. Dati par {{ tracked_n }} no {{ total }}.</p>
      </div>
      <p class="slv-ring-note"><span class="slv-key slv-key-ring" aria-hidden="true"></span>Gredzens — Prezidijs vai frakcijas priekšsēdētājs</p>
    </div>

    <aside class="slv-pop" id="slv-pop" aria-label="Deputāta kartīte" hidden>
      <div class="slv-pop-bar">
        <span class="slv-pop-grip" aria-hidden="true"></span>
        <button type="button" class="slv-pop-close" aria-label="Aizvērt kartīti">✕</button>
      </div>
      <div class="slv-pop-hint">
        <div class="slv-pop-hint-title">Izvēlies sēdvietu</div>
        <p>Pieskaries jebkuram aplim puslokā — šeit parādīsies deputāta kartīte.</p>
      </div>
      <div class="slv-pop-body"></div>
    </aside>
  </div>
  <div class="slv-backdrop" hidden></div>

  <section class="slv-prez" aria-labelledby="slv-prez-title">
    <div class="section-head">
      <div>
        <div class="section-head-kicker">Vada Saeimu</div>
        <h2 class="section-head-title" id="slv-prez-title">Prezidijs</h2>
      </div>
    </div>
    <ul class="slv-prez-grid" role="list">
      {% for s in presidium %}
      <li class="slv-prez-card" style="--seat-list:{{ s.list.color }}">
        {% if s.has_photo %}<img class="slv-prez-avatar" src="assets/photos/{{ s.slug }}.jpg" alt="" loading="lazy" decoding="async" width="64" height="64">{% else %}<span class="slv-prez-avatar slv-prez-avatar-ph" aria-hidden="true">{{ s.name.split()|map('first')|join('')|upper }}</span>{% endif %}
        <a class="slv-prez-name" href="#dep-{{ s.slug }}">{{ s.name }}</a>
        <span class="slv-prez-office">{{ s.office }}</span>
        <span class="slv-prez-party"><span class="slv-swatch" aria-hidden="true"></span>{{ s.list.short }}</span>
      </li>
      {% endfor %}
    </ul>
    <p class="slv-prez-note">Amati pēc saeima.lv datiem{% if offices_checked %}, pārbaudīti {{ offices_checked }}{% endif %}: <a href="{{ presidium_source_url|safe_url }}" target="_blank" rel="noopener">Prezidijs ↗</a> · <a href="{{ factions_source_url|safe_url }}" target="_blank" rel="noopener">frakcijas ↗</a></p>
  </section>

  <section class="slv-kom" aria-labelledby="slv-kom-title">
    <div class="section-head">
      <div>
        <div class="section-head-kicker">{{ committees|length }} pastāvīgās komisijas</div>
        <h2 class="section-head-title" id="slv-kom-title">Komisijas</h2>
      </div>
    </div>
    <div class="slv-kom-head" aria-hidden="true"><span>Komisija</span><span>Priekšsēdētājs</span><span>Locekļi</span></div>
    {% for c in committees %}
    <details class="slv-kom-item" id="{{ c.anchor }}">
      <summary class="slv-kom-sum">
        <span class="slv-kom-name">{{ c.name }}</span>
        <span class="slv-kom-chair" style="--seat-list:{{ c.chair.list.color }}"><span class="slv-swatch" aria-hidden="true"></span>{{ c.chair.name }} <span class="slv-kom-list">{{ c.chair.list.short }}</span></span>
        <span class="slv-kom-n">{{ c.n }}</span>
      </summary>
      <ul class="slv-kom-members" role="list">
        {% for m in c.members %}
        <li><a class="slv-kom-row" href="#dep-{{ m.slug }}" style="--seat-list:{{ m.list.color }}">
          <span class="slv-kom-mname">{{ m.name }}</span>
          <span class="slv-kom-title{% if m.role != 'member' %} is-lead{% endif %}">{{ m.title }}</span>
          <span class="slv-kom-mlist"><span class="slv-swatch" aria-hidden="true"></span>{{ m.list.short }}</span>
        </a></li>
        {% endfor %}
      </ul>
      {% if c.url %}<p class="slv-kom-src"><a href="{{ c.url|safe_url }}" target="_blank" rel="noopener">Komisijas lapa saeima.lv ↗</a></p>{% endif %}
    </details>
    {% endfor %}
    <p class="slv-prez-note">Sastāvs pēc saeima.lv{% if committees_checked %}, pārbaudīts {{ committees_checked }}{% endif %} · <a href="{{ committees_source_url|safe_url }}" target="_blank" rel="noopener">komisijas ↗</a></p>
    {% if mandates_n %}<p class="slv-prez-note">{{ mandates_n }} {{ mandates_n|lv_plural("deputāts", "deputāti") }} sēž ministru vietā: kamēr deputāts ir ministrs, viņa mandātu pilda nākamais kandidāts no tā paša saraksta.</p>{% endif %}
  </section>

  {% if cabinet %}
  <section class="slv-gov" aria-labelledby="slv-gov-title">
    <div class="section-head">
      <div>
        <div class="section-head-kicker">Ministru kabinets</div>
        <h2 class="section-head-title" id="slv-gov-title">Valdība</h2>
      </div>
      <a class="section-head-link" href="valdiba.html">Valdības lapa &rsaquo;</a>
    </div>
    <div class="slv-gov-head" aria-hidden="true"><span>Amats</span><span>Ministrs</span><span>Partija</span></div>
    <ul class="slv-gov-list" role="list">
      {% for c in cabinet %}
      <li><a class="slv-gov-row" href="valdiba.html#{{ c.anchor }}">
        <span class="slv-gov-post">{{ c.post }}</span>
        <span class="slv-gov-name">{{ c.name }}</span>
        <span class="slv-gov-party">{{ c.party_short or "—" }}</span>
      </a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="slv-lists" aria-labelledby="slv-lists-title">
    <div class="section-head">
      <div>
        <div class="section-head-kicker">Visi {{ total }}</div>
        <h2 class="section-head-title" id="slv-lists-title">Deputāti pa sarakstiem</h2>
      </div>
    </div>
    {% for l in lists %}
    <details class="slv-group" data-list="{{ l.nr }}" open style="--seat-list:{{ l.color }}">
      <summary class="slv-group-sum">
        <span class="slv-key slv-key-list" aria-hidden="true"></span>
        <span class="slv-group-title"><span class="slv-group-name">{{ l.name }}</span>{% if l.chair_label %}<span class="slv-group-chair">{{ l.chair_label }}</span>{% endif %}</span>
        <span class="slv-group-n">{{ l.seats_text }}</span>
      </summary>
      {#- Vadība grupas ķermenī, ne <summary>: saites kopsavilkumā pārslēgtu grupu
          un ekrānlasītājs tās nolasītu kā daļu no pogas. -#}
      {% if l.leadership %}
      <p class="slv-group-lead">Frakcijas vadība: {% for ld in l.leadership %}<a href="#dep-{{ ld.slug }}">{{ ld.name }}</a> <span class="slv-group-lead-title">({{ ld.title }})</span>{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% endif %}
      <div class="slv-deps">
        {% for s in l.members %}
        <details class="slv-dep" id="dep-{{ s.slug }}" data-slug="{{ s.slug }}" data-v14="{% if s.voted14 %}ja{% else %}ne{% endif %}" data-pos="{{ s.pos_bucket }}" data-ctr="{{ s.ctr_bucket }}"{% if gov %} data-gov="{{ s.gov }}" data-uzt="{{ s.uzt }}"{% endif %}>
          <summary class="slv-dep-sum">
            <span class="slv-dep-dot" aria-hidden="true"></span>
            {% if s.has_photo %}<img class="slv-dep-avatar" src="assets/photos/{{ s.slug }}.jpg" alt="" loading="lazy" decoding="async" width="36" height="36">{% else %}<span class="slv-dep-avatar slv-dep-avatar-ph" aria-hidden="true">{{ s.name.split()|map('first')|join('')|upper }}</span>{% endif %}
            <span class="slv-dep-ident">
              <span class="slv-dep-name">{{ s.name }}</span>
              {% if s.office_row %}<span class="slv-dep-role">{{ s.office_row }}</span>{% else %}<span class="slv-dep-region">{{ s.region }}</span>{% endif %}
            </span>
            {%- if gov %}
            <span class="slv-val" data-lens-val="gov">{{ s.gov_text }}</span>
            <span class="slv-val" data-lens-val="uzt">{{ s.uzt_text }}</span>
            {%- endif %}
            <span class="slv-val" data-lens-val="v14">{{ s.v14_text }}</span>
            <span class="slv-val" data-lens-val="pos">{{ s.pos_text }}</span>
            <span class="slv-val" data-lens-val="ctr">{{ s.ctr_text }}</span>
          </summary>
          {{ dep_card(s) }}
        </details>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </section>
</section>
{% endblock %}

{% block scripts %}
<script src="assets/slv1.js?v={{ assets_version }}" defer></script>
{% endblock %}
