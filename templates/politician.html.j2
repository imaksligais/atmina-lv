{% extends "base.html.j2" %}
{% set active_page = "" %}
{% set assets_prefix = "../" %}

{% block title %}{{ politician.name }}{% endblock %}

{% block jsonld %}
{%- set _profile_url = canonical_url|default(share_url) -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ politician.name|tojson }},
  {% if _profile_url %}"url": "{{ _profile_url }}",{% endif %}
  {% if politician.party %}"memberOf": {"@type": "Organization", "name": {{ politician.party|tojson }}},{% endif %}
  {%- if politician.x_handle %}
  "sameAs": ["https://x.com/{{ politician.x_handle }}"],
  {%- endif %}
  "knowsLanguage": "lv"
}
</script>
{% endblock %}

{% block content %}
{#- Profila lapa pēc 2026-10-07 dizaina (docs/plans/2026-10-07-profilu-dizains.md, B).
    Klases `pp-*` ir TIKAI šai lapai — `.profile-card` / `.profile-stats-bar` /
    `.timeline-*` paliek partiju un likumprojektu lapām. -#}
{% macro tab_button(id, label, count, default_tab) -%}
<button class="pp-tab{% if default_tab == id %} active{% endif %}" data-tab="{{ id }}" id="tab-btn-{{ id }}" role="tab" aria-controls="tab-{{ id }}" aria-selected="{% if default_tab == id %}true{% else %}false{% endif %}" tabindex="{% if default_tab == id %}0{% else %}-1{% endif %}">
  <span class="pp-tab-label">{{ label }}</span>{% if count is not none %}<span class="pp-tab-count">{{ count }}</span>{% endif %}
</button>
{%- endmacro %}

{% macro tl_icon(kind) -%}
<svg class="pp-tl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if kind == 'claim' %}<path d="M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4 3.5V16H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>
{%- elif kind == 'speech' %}<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"/>
{%- elif kind == 'question' %}<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10.5 11.5a2 2 0 1 1 2.6 1.9c-.6.2-1.1.7-1.1 1.3v.3M12 18h.01"/>
{%- else %}<rect x="4" y="4" width="16" height="16" rx="2"/><path d="m8.5 12.5 2.5 2.5 4.5-5.5"/>
{%- endif %}
</svg>
{%- endmacro %}

{% macro tl_item(e, cut=320) -%}
<li class="pp-tl-item pp-tl-{{ e.event_type }}" data-type="{{ e.event_type }}"{% if e.extra %} data-extra hidden{% endif %}>
  <time class="pp-tl-date" datetime="{{ e.date[:10] }}">{{ e.date_label }}</time>
  <span class="pp-tl-dot" aria-hidden="true"></span>
  {{ tl_icon(e.event_type) }}
  <div class="pp-tl-body">
    <h3 class="pp-tl-title">{{ e.title }}{% if e.meta %}<span class="pp-tl-meta"> · {{ e.meta }}</span>{% endif %}</h3>
    {% if e.event_type == 'claim' and e.topic %}<span class="pp-tl-topic">{{ e.topic }}</span>{% endif %}
    {% if e.detail %}<p class="pp-tl-detail">{{ e.detail|truncate(cut, true, '…', 0) }}</p>{% endif %}
    {% if e.link %}<a class="pp-tl-link" href="{{ e.link | safe_url }}" target="_blank" rel="noopener">{{ e.link_label }} ↗</a>
    {% elif e.href %}<a class="pp-tl-link" href="{{ e.href }}">{{ e.link_label }} →</a>
    {% elif e.tab_link %}<a class="pp-tl-link" href="#{{ e.tab_link }}" data-tab-link="{{ e.tab_link }}">{{ e.link_label }} →</a>{% endif %}
  </div>
</li>
{%- endmacro %}

<section class="section pp"{% if party_meta and party_meta.color %} style="--party-color: {{ party_meta.color }};"{% endif %}>
  <a href="../personas.html" class="back-link">&larr; Visi profili</a>

  <header class="pp-hero{% if bio %} has-bio{% endif %}">
    <div class="pp-photo">
      {% if has_photo %}
      <img src="../assets/photos/{{ politician.slug }}.jpg" alt="{{ politician.name }}" width="176" height="178" loading="eager" decoding="async" fetchpriority="high">
      {% else %}
      <span class="pp-photo-initials" aria-hidden="true">{{ politician.name[0] }}</span>
      {% endif %}
    </div>

    <div class="pp-id">
      <h1 class="pp-name">{{ politician.name }}</h1>
      <p class="pp-role pp-role-{{ politician.profile_kind }}">{{ politician.role_label }}</p>
      <div class="pp-meta">
        {% if party_meta %}
        <a href="../partijas/{{ party_meta.short_name|party_page_slug }}.html" class="pp-party"><span class="pp-party-dot" aria-hidden="true"></span>{{ politician.party }}</a>
        {% elif feed_outlet %}
        <a href="../mediji/{{ feed_outlet.slug }}.html" class="pp-party"><span class="pp-party-dot" aria-hidden="true"></span>{{ feed_outlet.name }}</a>
        {% elif politician.party %}
        <span class="pp-party pp-party-none"><span class="pp-party-dot" aria-hidden="true"></span>{{ politician.party }}</span>
        {% endif %}
        {% if politician.x_handle %}
        <a class="pp-social" href="https://x.com/{{ politician.x_handle }}" target="_blank" rel="noopener" title="@{{ politician.x_handle }} platformā X">
          <svg viewBox="0 0 24 24" class="pp-social-icon" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg><span>@{{ politician.x_handle }}</span>
        </a>
        {% endif %}
        {% for ep in external_profiles %}
          {% if ep.platform == 'facebook' %}
          <a class="pp-social" href="{{ ep.url | safe_url }}" target="_blank" rel="noopener" title="Facebook: {{ ep.handle or ep.url }}">
            <svg viewBox="0 0 24 24" class="pp-social-icon" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg><span>Facebook</span>
          </a>
          {% elif ep.platform == 'website' %}
          <a class="pp-social" href="{{ ep.url | safe_url }}" target="_blank" rel="noopener" title="Tīmekļa vietne: {{ ep.url }}">
            <svg viewBox="0 0 24 24" class="pp-social-icon" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm7.93 9h-3.04a15.5 15.5 0 0 0-1.2-5.32A8.03 8.03 0 0 1 19.93 11zM12 4c1.36 1.97 2.16 4.36 2.36 7H9.64C9.84 8.36 10.64 5.97 12 4zM4.07 13h3.04c.13 1.84.55 3.65 1.2 5.32A8.03 8.03 0 0 1 4.07 13zm0-2A8.03 8.03 0 0 1 8.31 5.68 15.5 15.5 0 0 0 7.11 11H4.07zM12 20c-1.36-1.97-2.16-4.36-2.36-7h4.72c-.2 2.64-1 5.03-2.36 7zm3.69-1.68c.65-1.67 1.07-3.48 1.2-5.32h3.04a8.03 8.03 0 0 1-4.24 5.32z"/></svg><span>Vietne</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% if share_url %}
      <div class="share-row pp-share">
        {%- set share_text = politician.name ~ " — atmina.lv" -%}
        <a class="share-btn share-btn-x" href="https://x.com/intent/tweet?text={{ share_text|urlencode }}&url={{ share_url|urlencode }}" target="_blank" rel="noopener" title="Dalīties uz X">𝕏 Dalīties</a>
        <button type="button" class="share-btn share-btn-copy" data-copy-url="{{ share_url }}" data-copy-state="1" aria-live="polite">Kopēt saiti</button>
      </div>
      {% endif %}
    </div>

    {# Bio — tikai strukturēti fakti ar avotu (src/render/bio.py): CVK
       kandidāta ziņas (status: ok) — pašreizējās darbavietas kandidāta
       redakcijā; VID deklarāciju amati — tikai sakļauta vēsture (gadi ir
       deklarāciju gadi, ne precīzi amata datumi). Nav datu → nav bloka. #}
    {% if bio %}
    <aside class="profile-bio" aria-label="Biogrāfija">
      {% if bio.birth_year or bio.education %}
      <p class="profile-bio-facts">
        {%- if bio.birth_year %}<span>dz. {{ bio.birth_year }}</span>{% endif -%}
        {%- for e in bio.education %}<span>{% if e.institution %}{{ e.institution }}{% if e.year %} ({{ e.year }}){% endif %}{% if e.degree %}: {{ e.degree }}{% endif %}{% else %}{{ e.degree }}{% endif %}</span>{% endfor -%}
      </p>
      {% endif %}
      {% if bio.workplaces %}
      <div class="profile-bio-label">{% if bio.workplaces|selectattr("employer")|list %}Darbavietas{% else %}Nodarbošanās{% endif %} pēc CVK ziņām</div>
      <ul class="profile-bio-list">
        {% for w in bio.workplaces %}<li><span>{{ [w.position, w.employer]|select|join(', ') }}</span></li>{% endfor %}
      </ul>
      {% endif %}
      {% if bio.career %}
      <details class="profile-bio-more">
        <summary>Amati VID deklarācijās ({{ bio.career|length }})</summary>
        <p class="profile-bio-note">Gadi — deklarāciju gadi, ne precīzi amata datumi.</p>
        <ul class="profile-bio-list">
          {% for r in bio.career %}<li><span class="profile-bio-years">{{ r.years }}</span> <span>{{ r.position }}{% if r.position and r.entity %}, {% endif %}{{ r.entity }}</span></li>{% endfor %}
        </ul>
      </details>
      {% endif %}
      <p class="profile-bio-src">Avoti:
        {% if bio.cvk_url %}<a href="{{ bio.cvk_url | safe_url }}" target="_blank" rel="noopener">CVK kandidāta ziņas</a> (kandidāta sniegtajā redakcijā) ·{% endif %}
        {% if bio.ep_url %}<a href="{{ bio.ep_url | safe_url }}" target="_blank" rel="noopener">Eiropas Parlamenta deputāta lapa</a> ·{% endif %}
        {% if bio.career and 'deklaracijas' in tab_set %}<a href="#deklaracijas" data-tab-link="deklaracijas">VID deklarācijas</a> ·{% endif %}
        <a href="../kontakti.html">Ieteikt labojumu</a>
      </p>
    </aside>
    {% endif %}
  </header>

  {# default_tab = tab_set[0] — _profile_tab_set jau curated default
     atkarīgi no profile_kind un data presence (spec § 4.1). #}
  {% set default_tab = tab_set[0] if tab_set else 'timeline' %}
  {# ARIA tablist: aria-selected sinhronizēts ar `active` klasi; aria-controls
     saista pogu → tabpanel. Roving tabindex (T3, 2026-09-05): tabulācijas
     secībā ir TIKAI aktīvā cilne (`tabindex="0"`), pārējās `-1` — starp
     cilnēm pārvieto bultas un Home/End (`assets/ppv1.js`). Pārskata cilnei
     skaitļa nav: parskats_data|length ir signālu BLOKU skaits, ne apjoms. #}
  <div class="pp-tabs" role="tablist" aria-label="Profila sadaļas">
    {% if 'parskats' in tab_set %}{{ tab_button('parskats', 'Pārskats', none, default_tab) }}{% endif %}
    {% if 'timeline' in tab_set %}{{ tab_button('timeline', 'Laika līnija', timeline_total if timeline_total is defined else timeline|length, default_tab) }}{% endif %}
    {% if 'pozicijas' in tab_set %}{{ tab_button('pozicijas', 'Pozīcijas', positions|length, default_tab) }}{% endif %}
    {% if 'saeima' in tab_set %}{{ tab_button('saeima', 'Saeimā', votes_total, default_tab) }}{% endif %}
    {% if 'komentari-by' in tab_set and commentary_by %}{{ tab_button('komentari-by', 'Komentāri', commentary_by|length, default_tab) }}{% endif %}
    {% if 'publikacijas' in tab_set and (x_posts or news or own_pubs) %}{{ tab_button('publikacijas', 'Publikācijas', pub_totals.x + pub_totals.news + pub_totals.own, default_tab) }}{% endif %}
    {% if 'pretrunas' in tab_set and contradictions %}{{ tab_button('pretrunas', 'Pretrunas', contradictions|length, default_tab) }}{% endif %}
    {% if 'saites' in tab_set and (saites_data.uzbrukumi or saites_data.spriedzes or saites_data.atbalsts or saites_data.commentary_about or saites_data.vote_alignment_top) %}
    {# Saites skaits = VISI cilnes saturi: uzbrukumi/spriedzes/atbalsts (REĀLAIS
       kopskaits, ne griestotais saraksts) + komentāri par šo politiķi +
       balsojumu sakritības kaimiņi — saites_count nāk no _fetch_politician_detail. #}
    {{ tab_button('saites', 'Saites', saites_count, default_tab) }}
    {% endif %}
    {% if 'deklaracijas' in tab_set %}{{ tab_button('deklaracijas', 'Deklarācijas', vad_data|length, default_tab) }}{% endif %}
  </div>

  {# Skaitļu josla (plāns B.3): līdz 4 flīzēm pēc profile_kind, nulles nav.
     Tukšs saraksts → «Vēl nav datu» — profilu NEslēpj. #}
  {% if stat_tiles %}
  <div class="pp-stats pp-stats-{{ stat_tiles|length }}">
    {% for t in stat_tiles %}
    {% if t.tab %}<a class="pp-stat" href="#{{ t.tab }}" data-tab-link="{{ t.tab }}">{% else %}<div class="pp-stat">{% endif %}
      <span class="pp-stat-value">{{ t.value }}</span>
      <span class="pp-stat-text"><span class="pp-stat-label">{{ t.label }}</span><span class="pp-stat-sub">{{ t.sub }}</span></span>
    {% if t.tab %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
  {% else %}
  <div class="pp-empty">
    <p class="pp-empty-title">Vēl nav datu</p>
    <p class="pp-empty-text">Par šo profilu vēl nav saglabātu pozīciju, balsojumu, pretrunu vai publikāciju. Lapa papildināsies, tiklīdz parādīsies jauni avoti.</p>
  </div>
  {% endif %}

  <!-- Tab content starts here -->

  <!-- Pārskats tab — jaunākā aktivitāte + mēnešu grafiks, zem tiem 3 signālu
       bloki + wiki/sintēzes. Spec: docs/superpowers/specs/2026-05-14-profila-parskats-design.md § 3 -->
  {% if 'parskats' in tab_set %}
  <div class="profile-tab profile-tab-parskats" id="tab-parskats" role="tabpanel" aria-labelledby="tab-btn-parskats"{% if default_tab != 'parskats' %} style="display:none;"{% endif %}>
    <div class="pp-overview">
      <section class="pp-ov-activity" aria-labelledby="pp-ov-tl-h">
        <h2 class="pp-h2" id="pp-ov-tl-h">Jaunākā aktivitāte</h2>
        {% if timeline %}
        <ol class="pp-tl pp-tl-compact">
          {% for e in timeline[:parskats_timeline_rows] %}{{ tl_item(e, 150) }}{% endfor %}
        </ol>
        {% if 'timeline' in tab_set and (timeline_total if timeline_total is defined else timeline|length) > parskats_timeline_rows %}
        <a class="pp-more" href="#timeline" data-tab-link="timeline">Skatīt visu laika līniju →</a>
        {% endif %}
        {% else %}
        <p class="pp-muted">Nav notikumu.</p>
        {% endif %}
      </section>

      {% if monthly %}
      <section class="pp-ov-chart" aria-labelledby="pp-chart-h">
        <h2 class="pp-h2" id="pp-chart-h">Aktivitāte pa mēnešiem</h2>
        {% if monthly.total %}
        <figure class="pp-chart">
          <ul class="pp-chart-legend">
            {% for s in monthly.series %}<li class="pp-chart-key pp-key-{{ s.key }}"><span class="pp-swatch" aria-hidden="true"></span>{{ s.label }}</li>{% endfor %}
          </ul>
          <div class="pp-chart-plot">
            <div class="pp-chart-yaxis" aria-hidden="true">
              {% for t in monthly.ticks %}<span style="bottom: {{ t.pct }}%">{{ t.value }}</span>{% endfor %}
            </div>
            <svg class="pp-chart-svg" viewBox="0 0 360 100" preserveAspectRatio="none" role="img" aria-label="Aktivitāte pa mēnešiem no {{ monthly.first_label }} līdz {{ monthly.last_label }}; skaitļi — tabulā zem grafika">
              {% for t in monthly.ticks %}<line class="pp-chart-grid" x1="0" x2="360" y1="{{ 100 - t.pct }}" y2="{{ 100 - t.pct }}" vector-effect="non-scaling-stroke"/>{% endfor %}
              {% for m in monthly.months %}
              <g class="pp-chart-month" data-month="{{ m.ym }}" data-counts="{{ m.counts|join(',') }}">
                <title>{{ m.title }}</title>
                <rect class="pp-chart-hit" x="{{ m.x }}" y="0" width="{{ monthly.group_w }}" height="100"/>
                {% for b in m.bars %}<rect class="pp-bar pp-bar-{{ b.key }}" x="{{ b.x }}" y="{{ b.y }}" width="{{ monthly.bar_w }}" height="{{ b.h }}"/>{% endfor %}
              </g>
              {% endfor %}
            </svg>
            <div class="pp-chart-xaxis" aria-hidden="true">
              {% for m in monthly.months %}<span>{{ m.label }}</span>{% endfor %}
            </div>
          </div>
          <details class="pp-chart-table">
            <summary>Skatīt tabulā</summary>
            <div class="table-wrap">
              <table class="data-table">
                <thead><tr><th>Mēnesis</th>{% for s in monthly.series %}<th>{{ s.label }}</th>{% endfor %}</tr></thead>
                <tbody>
                  {% for m in monthly.months|reverse %}<tr><td>{{ m.full }}</td>{% for v in m.counts %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}
                </tbody>
              </table>
            </div>
          </details>
        </figure>
        {% else %}
        <p class="pp-muted pp-chart-empty">Pēdējos 12 mēnešos nav pozīciju, uzstāšanos debatēs vai iesniegtu jautājumu.</p>
        {% endif %}
        <p class="pp-chart-note">Saeimas balsojumi šeit netiek skaitīti — tie ir cilnē «Saeimā».</p>
      </section>
      {% endif %}
      {% if parskats_data.latest_activity or parskats_data.top_contradiction or parskats_data.dominant_topics or parskats_data.faction_alignment %}
      <div class="pp-ov-signals">
        {% if parskats_data.latest_activity %}
        {% set la = parskats_data.latest_activity %}
        {# Balsojuma gadījumā — sēdes dienas rinda kā Laika līnijā, nevis viena
           balsojuma motīvs (T14: procedurāls balsojums izskatās pēc nostājas). #}
        <div class="parskats-block parskats-block-activity">
          <div class="parskats-kicker">Pēdējā aktivitāte · {{ la.relative }}</div>
          {% if la.type == 'vote' %}
          <h3 class="parskats-headline">Saeimas sēde · {{ la.meta }}</h3>
          <p class="parskats-body">{{ la.date|lv_date }}</p>
          {% if 'saeima' in tab_set %}<a href="#saeima" data-tab-link="saeima">Skatīt balsojumus →</a>{% endif %}
          {% else %}
          <h3 class="parskats-headline">
            Pozīcija{% if la.topic %} · <span class="topic-tag">{{ la.topic }}</span>{% endif %}
          </h3>
          <p class="parskats-body">{{ la.content }}{% if la.content|length >= 200 %}…{% endif %}</p>
          {% if la.source_url %}
          <a href="{{ la.source_url | safe_url }}" target="_blank" rel="noopener">Avots →</a>
          {% endif %}
          {% endif %}
        </div>
        {% endif %}

        {% if parskats_data.top_contradiction %}
        <div class="parskats-block parskats-block-contradiction">
          <div class="parskats-kicker">Ievērojamākā pretruna{% if parskats_data.top_contradiction.delta_days is not none %} · ΔT {{ parskats_data.top_contradiction.delta_days }}d{% endif %}</div>
          {% if parskats_data.top_contradiction.topic %}
          <h3 class="parskats-headline">{{ parskats_data.top_contradiction.topic }}</h3>
          {% endif %}
          <p class="parskats-body">{{ parskats_data.top_contradiction.summary }}{% if parskats_data.top_contradiction.summary|length >= 240 %}…{% endif %}</p>
          <a href="../pretrunas.html#pretruna-{{ parskats_data.top_contradiction.id }}">Pilna pretruna →</a>
        </div>
        {% endif %}

        {% if parskats_data.dominant_topics %}
        <div class="parskats-block parskats-block-topics">
          <div class="parskats-kicker">Pēdējos 6 mēnešos visvairāk runā par</div>
          <div class="parskats-topics-list">
            {#- Deep-link uz Pozīciju cilni AR uzliktu tēmas filtru: href nes
               kanonisko tēmu kā ?tema= (URL-kodēts), data-topic — to pašu vērtību
               nekodētu, lai ppv1.js atrod atbilstošo #topic-filter pogu bez
               atkodēšanas. -#}
            {% for t in parskats_data.dominant_topics %}
            <a href="{{ politician.slug }}.html?tema={{ t.topic|urlencode }}#pozicijas" class="parskats-topic-chip" data-tab-link="pozicijas" data-topic="{{ t.topic }}">{{ t.topic }} · {{ t.count }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {%- if parskats_data.faction_alignment %}
        {% set fa = parskats_data.faction_alignment %}
        {#- Plāns docs/plans/2026-10-09-parskats-frakcijas-sakritiba.md: pct = floor,
           saucējs vienmēr blakus procentam; frakcija = tā balsojuma frakcija (T6). -#}
        <div class="parskats-block parskats-block-faction">
          <div class="parskats-kicker">Balso kopā ar savu frakciju</div>
          <h3 class="parskats-headline">{{ fa.pct }} %</h3>
          <p class="parskats-body">{{ fa.body }}</p>
          <p class="pp-chart-note">Skaitītas tikai «Par», «Pret» un «Atturas» balsis; frakcijas vairākums — pārējo frakcijas deputātu biežākā balss.</p>
          {% if 'saeima' in tab_set %}<a href="#saeima" data-tab-link="saeima">Skatīt balsojumus →</a>{% endif %}
        </div>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {% if wiki_profile %}
    <div class="wiki-profile post-content pp-wiki">
      {{ wiki_profile | safe }}
    </div>
    {% endif %}

  </div>
  {% endif %}

  <!-- Timeline tab — vienotais aktivitātes avots (_fetch_activity_timeline) -->
  {% if 'timeline' in tab_set %}
  <div class="profile-tab" id="tab-timeline" role="tabpanel" aria-labelledby="tab-btn-timeline"{% if default_tab != 'timeline' %} style="display:none;"{% endif %}>
    {% if timeline %}
    <div class="pp-tl-head">
      <h2 class="pp-h2">Aktivitāšu laika līnija</h2>
      {% if timeline_types|length > 1 %}
      <div class="pp-tl-filter" role="group" aria-label="Rādīt notikumu veidu">
        <span class="pp-tl-filter-label" aria-hidden="true">Rādīt:</span>
        <button type="button" class="pp-tl-filter-btn active" aria-pressed="true" data-tl-filter="all">Visu</button>
        {% for t in timeline_types %}<button type="button" class="pp-tl-filter-btn" aria-pressed="false" data-tl-filter="{{ t[0] }}">{{ t[1] }}</button>{% endfor %}
      </div>
      {% endif %}
    </div>
    <ol class="pp-tl" id="pp-timeline">
      {% for e in timeline %}{{ tl_item(e) }}{% endfor %}
    </ol>
    {%- if timeline_total is defined and timeline_total > timeline_shown %}
    <p class="pp-muted pp-tl-note">Rādīti jaunākie {{ timeline_shown }} no {{ timeline_total }} notikumiem. Atsevišķi balsojumi — cilnē «Saeimā».</p>
    {%- endif %}
    {% else %}
    <p class="pp-muted">Laika līnijā vēl nav pozīciju, uzstāšanos debatēs, iesniegtu jautājumu vai Saeimas sēžu balsojumu.</p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Pozīcijas tab -->
  {% if 'pozicijas' in tab_set %}
  <div class="profile-tab" id="tab-pozicijas" role="tabpanel" aria-labelledby="tab-btn-pozicijas"{% if default_tab != 'pozicijas' %} style="display:none;"{% endif %}>
    <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.75rem;">
      {% if claim_topics %}
      <div class="filter-bar topic-filter" id="topic-filter" style="margin-bottom:0;">
        <button class="filter-btn topic-filter-btn active" aria-pressed="true" data-filter="all">Visas tēmas <span class="filter-count">{{ positions|length }}</span></button>
        {% for chip in claim_topic_chips %}
        {% if loop.index <= claim_topic_chips_visible %}
        <button class="filter-btn topic-filter-btn" aria-pressed="false" data-filter="{{ chip.name }}" style="--filter-color: {{ chip.color }}"><span class="filter-dot"></span>{{ chip.name }} <span class="filter-count">{{ chip.count }}</span></button>
        {% else %}
        <button class="filter-btn topic-filter-btn topic-filter-more" hidden aria-pressed="false" data-filter="{{ chip.name }}" style="--filter-color: {{ chip.color }}"><span class="filter-dot"></span>{{ chip.name }} <span class="filter-count">{{ chip.count }}</span></button>
        {% endif %}
        {% endfor %}
        {% if claim_topic_chips|length > claim_topic_chips_visible %}
        <button type="button" class="topic-filter-toggle" data-topic-more-toggle aria-expanded="false">{% set more_n = claim_topic_chips|length - claim_topic_chips_visible %}Vēl {{ more_n }} {{ "tēma" if more_n % 10 == 1 and more_n % 100 != 11 else "tēmas" }}</button>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {% if positions %}
    <div class="table-wrap">
      <table class="data-table" id="claims-table">
        <thead>
          <tr>
            <th>Tēma</th>
            <th>Pozīcija</th>
            <th>Datums</th>
            <th>Avots</th>
          </tr>
        </thead>
        <tbody>
          {% for c in positions %}
          <tr data-topic="{{ c.topic }}" data-vote="false">
            <td><span class="claim-topic">{{ c.topic }}</span></td>
            <td>{{ c.stance }}
              {#- Citāts VERBATIM (pilns, bez pēdiņu ietinuma) — pierādījums, uz kā
                 balstīta parafrāze. Bez citāta nav kontroles. <details> JS neprasa. #}
              {%- if c.quote and c.quote|trim %}
              <details class="pp-quote"><summary>Citāts</summary><blockquote class="pp-quote-text">{{ c.quote }}</blockquote></details>
              {%- endif %}</td>
            <td style="white-space:nowrap">{{ c.stated_at[:10] if c.stated_at else '' }}</td>
            <td>{% if c.source_url %}<a href="{{ c.source_url | safe_url }}">Avots</a>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p style="color:var(--text-muted);">Nav pozīciju.{% if 'saeima' in tab_set %} Saeimas balsojumi tiek rādīti atsevišķi cilnē "Saeimā".{% endif %}</p>
    {% endif %}

    {# X+Ziņas tucked under Pozīcijas for non-journalist kinds.
       Journalist/analyst profiles get a dedicated Publikācijas tab instead. #}
    {% if 'publikacijas' not in tab_set %}
      {% if x_posts %}
      <h2 style="margin-top:2rem; font-size:1rem; color:var(--text-muted);">X ieraksti ({{ x_posts|length }}{% if pub_totals.x > x_posts|length %} jaunākie no {{ pub_totals.x }}{% endif %})</h2>
      {% for p in x_posts %}
      <div class="card profile-feed-card">
        <div class="profile-feed-meta">
          <span>{{ p.source_domain or 'x.com' }}</span>
          <span>{{ (p.published_at or p.scraped_at)[:10] if (p.published_at or p.scraped_at) else '' }}</span>
        </div>
        <div class="profile-feed-body profile-feed-body-x">{{ p.content[:280] }}{% if p.content and p.content|length > 280 %}…{% endif %}</div>
        {% if p.source_url %}<a href="{{ p.source_url | safe_url }}" target="_blank" rel="noopener" class="profile-feed-link">Atvērt X ↗</a>{% endif %}
      </div>
      {% endfor %}
      {% endif %}

      {% if news %}
      <h2 style="margin-top:2rem; font-size:1rem; color:var(--text-muted);">Ziņas ({{ news|length }}{% if pub_totals.news > news|length %} no {{ pub_totals.news }}{% endif %})</h2>
      {% for n in news %}
      <div class="card profile-feed-card">
        <div class="profile-feed-meta">
          <span>{{ n.source_domain or '' }}{% if n.role == 'mentioned' %} <span class="muted-tag">pieminēts</span>{% endif %}</span>
          <span>{{ n.scraped_at[:10] if n.scraped_at else '' }}</span>
        </div>
        <div class="profile-feed-body">{{ n.preview }}{% if n.preview and n.preview|length >= 200 %}…{% endif %}</div>
        {% if n.source_url %}<a href="{{ n.source_url | safe_url }}" target="_blank" rel="noopener" class="profile-feed-link">Lasīt pilnu rakstu ↗</a>{% endif %}
      </div>
      {% endfor %}
      {% endif %}
    {% endif %}
  </div>
  {% endif %}

  <!-- Pretrunas tab -->
  {% if 'pretrunas' in tab_set and contradictions %}
  <div class="profile-tab" id="tab-pretrunas" role="tabpanel" aria-labelledby="tab-btn-pretrunas"{% if default_tab != 'pretrunas' %} style="display:none;"{% endif %}>
    <div class="grid-2">
      {% for c in contradictions %}
      <article class="prv2-card sev-{{ c.severity }}">
        <div class="prv2-partybar" style="background: {{ c.party_color }}"></div>

        <header class="prv2-head">
          <div class="prv2-persona">
            {%- if c.has_photo %}
            <img class="prv2-avatar prv2-avatar-photo" src="{{ assets_prefix }}assets/photos/{{ c.slug }}.jpg" alt="{{ c.politician_name }}" loading="lazy" decoding="async" style="--pc: {{ c.party_color }}">
            {%- else %}
            <span class="prv2-avatar" style="--pc: {{ c.party_color }}">{{ c.initials }}</span>
            {%- endif %}
            <div class="prv2-persona-text">
              <div class="prv2-name">{{ c.politician_name }}</div>
              <div class="prv2-role">{{ c.party_short }}</div>
            </div>
          </div>
          <div class="prv2-meta-mid">
            <span class="prv2-sevbadge">{{ c.severity_glyph }} {{ c.category_label or c.severity_lv }}</span>
            {% if c.topic %}<span class="prv2-topic">{{ c.topic }}</span>{% endif %}
          </div>
          {% if c.delta_days is not none %}
          <div class="prv2-meta-right">
            <div class="prv2-datacell">
              <span class="prv2-datacell-l">ΔT</span>
              <span class="prv2-datacell-v">{{ c.delta_days }}d</span>
            </div>
          </div>
          {% endif %}
        </header>

        {% if c.summary %}
        <section class="prv2-summary">
          <div class="prv2-kicker">Kopsavilkums</div>
          <p>{{ c.summary | autolink_bills(bill_slugs, assets_prefix) | safe }}</p>
        </section>
        {% endif %}

        {% if c.context_note %}
        <aside class="prv2-context">
          <span class="prv2-context-kicker">Konteksts</span>
          {{ c.context_note }}
        </aside>
        {% endif %}

        <div class="prv2-split">
          <div class="prv2-pane prv2-pane-old">
            <div class="prv2-kicker">{{ c.old_label or 'Iepriekš' }}</div>
            <div class="prv2-pane-meta">
              <time datetime="{{ c.old_date }}">{{ c.old_date }}</time>
              {% if c.old_source %}
              · <a href="{{ c.old_source }}" target="_blank" rel="noopener">{{ c.old_source_domain }} ↗</a>
              {% endif %}
            </div>
            <div class="prv2-stance">{{ c.old_stance }}</div>
            {% if c.old_quote %}
            <blockquote class="prv2-quote">{{ c.old_quote }}</blockquote>
            {% else %}
            <div class="prv2-quote-fallback">Citāts nav pieejams — parafrāze no avota</div>
            {% endif %}
          </div>

          <div class="prv2-gutter">
            <span class="prv2-gutter-disc" aria-hidden="true">{{ c.severity_glyph }}</span>
          </div>

          <div class="prv2-pane prv2-pane-new">
            <div class="prv2-kicker prv2-kicker-sev">{{ c.new_label or 'Pašlaik' }}</div>
            <div class="prv2-pane-meta">
              <time datetime="{{ c.new_date }}">{{ c.new_date }}</time>
              {% if c.new_source %}
              · <a href="{{ c.new_source }}" target="_blank" rel="noopener">{{ c.new_source_domain }} ↗</a>
              {% endif %}
            </div>
            <div class="prv2-stance">{{ c.new_stance }}</div>
            {% if c.new_quote %}
            <blockquote class="prv2-quote">{{ c.new_quote }}</blockquote>
            {% else %}
            <div class="prv2-quote-fallback">Citāts nav pieejams — parafrāze no avota</div>
            {% endif %}
            {% if c.vote_summary %}
            <div class="prv2-vote">
              <span class="prv2-vote-kicker">Likumprojekts</span>
              {{ c.vote_summary }}
            </div>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- Saeimā tab (votes + bills combined) -->
  {% if 'saeima' in tab_set %}
  <div class="profile-tab" id="tab-saeima" role="tabpanel" aria-labelledby="tab-btn-saeima"{% if default_tab != 'saeima' %} style="display:none;"{% endif %}>
    {% if politician.profile_kind == 'former' %}
    <p style="color:var(--text-muted); font-style:italic; margin-bottom:0.75rem;">Vēsturisks (bijušais deputāts) — nav aktīvs Saeimā.</p>
    {% endif %}
    {% if vote_date_range %}
    <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:0.75rem;">Balsojumu ieraksti: {{ vote_date_range.min|lv_date }} – {{ vote_date_range.max|lv_date }}</p>
    {% endif %}
    {%- if mandate_note %}
    <p class="pp-vote-note">{{ mandate_note }}</p>
    {%- endif %}
    {% if votes %}
    <p class="pp-vote-note">«Atturas» nav neitrāla balss: deputāts ir klātesošs, bet priekšlikumu neatbalsta. Lēmumam vajag klātesošo vairākumu, tāpēc «Atturas» sver tāpat kā «Pret».</p>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Datums</th>
            <th>Jautājums</th>
            <th>Balsojums</th>
          </tr>
        </thead>
        <tbody>
          {% for v in votes %}
          <tr>
            <td style="white-space:nowrap">{{ v.vote_date|lv_date }}</td>
            <td>{{ v.motif|truncate(80, False, '…', 0) }}</td>
            <td>
              <span class="badge {% if v.vote == 'Par' %}badge-green{% elif v.vote == 'Pret' %}badge-red{% elif v.vote == 'Atturas' %}badge-yellow{% else %}badge-muted{% endif %}"{% if v.vote == 'Atturas' %} title="Atturējās — priekšlikumu neatbalstīja"{% endif %}>{{ v.vote }}</span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if votes_total > votes|length %}
    <p style="color:var(--text-muted); font-size:0.85rem; margin-top:0.5rem;">
      Rādīti jaunākie {{ votes|length }} no {{ votes_total }} balsojumiem. Pilns saraksts pa deputātiem: <a href="{{ assets_prefix }}balsojumi.html">Balsojumu matrica ↗</a>
    </p>
    {% endif %}
    {% endif %}

    {% if bills_involved %}
    <h2 style="margin-top:1.5rem; font-size:1.25rem;">Likumprojekti ({{ bills_involved|length }})</h2>
    <div class="bill-card-grid">
      {% from "_bill_card.html.j2" import bill_card %}
      {% for b in bills_involved %}{{ bill_card(b, prefix=assets_prefix) }}{% endfor %}
    </div>
    {% endif %}
    {#- Saeimas aktivitāte (plāns 2026-10-06). `{%-` tur tukšo izvadi baitu-identisku. #}
    {%- if saeima_roles and (saeima_roles.current or saeima_roles.ended) %}
    <section class="saeima-activity" aria-labelledby="saeima-amati-h">
      <h2 class="saeima-activity-title" id="saeima-amati-h">Amati Saeimā</h2>
      {% if saeima_roles.current %}
      <dl class="saeima-roles">
        {% for g in saeima_roles.current %}
        <div class="saeima-roles-group">
          <dt>{{ g.label }}</dt>
          {% for r in g.roles %}
          <dd>
            <span class="saeima-role-body">{{ r.body }}</span>
            {% if r.role %}<span class="badge badge-blue">{{ r.role }}</span>{% endif %}
            <span class="saeima-role-dates">kopš {{ r.date_from|lv_date }}</span>
          </dd>
          {% endfor %}
        </div>
        {% endfor %}
      </dl>
      {% endif %}
      {% if saeima_roles.ended %}
      <details class="saeima-roles-past">
        <summary>Iepriekšējie amati ({{ saeima_roles.ended|length }})</summary>
        <ul>
          {% for r in saeima_roles.ended %}
          <li>
            <span class="saeima-role-body">{{ r.body }}</span>
            {% if r.role %}<span class="badge badge-muted">{{ r.role }}</span>{% endif %}
            <span class="saeima-role-dates">{{ r.date_from|lv_date }} – {{ r.date_to|lv_date }}</span>
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </section>
    {%- endif %}
    {%- if saeima_speeches and saeima_speeches.rows %}
    <section class="saeima-activity" aria-labelledby="saeima-debates-h">
      <h2 class="saeima-activity-title" id="saeima-debates-h">Uzstāšanās debatēs</h2>
      <p class="saeima-activity-summary">{{ saeima_speeches.total }} {{ saeima_speeches.total|lv_plural("uzstāšanās", "uzstāšanās") }}{% if saeima_speeches.time %} · kopējais runas laiks {{ saeima_speeches.time }}{% endif %}</p>
      <div class="table-wrap">
        <table class="data-table saeima-activity-table">
          <thead>
            <tr>
              <th>Datums</th>
              <th>Darba kārtības jautājums</th>
              <th>Ilgums</th>
            </tr>
          </thead>
          <tbody>
            {% for s in saeima_speeches.rows %}
            <tr>
              <td class="saeima-activity-date">{{ s.session_date|lv_date }}</td>
              {% set s_title = s.item_title or s.document_nr or '' %}
              <td{% if s_title|length > 140 %} title="{{ s_title }}"{% endif %}>{% if s.bill_slug %}<a href="{{ assets_prefix }}likumprojekti/{{ s.bill_slug }}.html">{{ s_title|truncate(140, true, '…', 0) }}</a>{% else %}{{ s_title|truncate(140, true, '…', 0) }}{% endif %}</td>
              <td class="saeima-activity-date">{{ s.duration }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if saeima_speeches.total > saeima_speeches.rows|length %}
      <p class="saeima-activity-note">Rādītas jaunākās {{ saeima_speeches.rows|length }} no {{ saeima_speeches.total }}.</p>
      {% endif %}
    </section>
    {%- endif %}
    {%- if saeima_questions and saeima_questions.rows %}
    <section class="saeima-activity" aria-labelledby="saeima-questions-h">
      <h2 class="saeima-activity-title" id="saeima-questions-h">Jautājumi un pieprasījumi</h2>
      <p class="saeima-activity-summary">Iesniegti:
        {%- if saeima_questions.jautajumi %} {{ saeima_questions.jautajumi }} {{ saeima_questions.jautajumi|lv_plural("jautājums", "jautājumi") }}{% endif %}
        {%- if saeima_questions.jautajumi and saeima_questions.pieprasijumi %},{% endif %}
        {%- if saeima_questions.pieprasijumi %} {{ saeima_questions.pieprasijumi }} {{ saeima_questions.pieprasijumi|lv_plural("pieprasījums", "pieprasījumi") }}{% endif %}</p>
      <div class="table-wrap">
        <table class="data-table saeima-activity-table">
          <thead>
            <tr>
              <th>Datums</th>
              <th>Jautājums</th>
              <th>Statuss</th>
            </tr>
          </thead>
          <tbody>
            {% for q in saeima_questions.rows %}
            <tr>
              <td class="saeima-activity-date">{{ q.submitted_date|lv_date }}</td>
              <td><span class="saeima-activity-docnr">{{ q.doc_nr }}</span> <a href="{{ q.source_url | safe_url }}" target="_blank" rel="noopener">{{ q.title or q.doc_nr }} ↗</a></td>
              <td>{% if q.status_short %}<span class="badge badge-muted" title="{{ q.result or q.status }}">{{ q.status_short }}</span>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if (saeima_questions.jautajumi + saeima_questions.pieprasijumi) > saeima_questions.rows|length %}
      <p class="saeima-activity-note">Rādīti jaunākie {{ saeima_questions.rows|length }}.</p>
      {% endif %}
    </section>
    {%- endif %}
  </div>
  {% endif %}

  <!-- Komentāri-by tab (žurnālisti / analītiķi: viņu komentāri par citiem) -->
  {% if 'komentari-by' in tab_set %}
  <div class="profile-tab" id="tab-komentari-by" role="tabpanel" aria-labelledby="tab-btn-komentari-by"{% if default_tab != 'komentari-by' %} style="display:none;"{% endif %}>
    {% if commentary_by %}
    <p style="color:var(--text-muted); margin-bottom:1rem;">{{ politician.name }} komentāri par citiem politiķiem ({{ commentary_by|length }}).</p>
    <div class="komentari-grid">
      {% for c in commentary_by %}
      <article class="komentari-card">
        <header class="komentari-head">
          <span class="komentari-speaker">
            <a href="../politiki/{{ c.target_slug }}.html">{{ c.target_name }}</a>
          </span>
          <span class="komentari-date">{{ c.stated_at[:10] if c.stated_at else c.created_at[:10] }}</span>
        </header>
        {% if c.topic %}<div class="komentari-topic">{{ c.topic }}</div>{% endif %}
        <p class="komentari-stance">{{ c.stance }}</p>
        {% if c.quote %}
        <blockquote class="komentari-quote">"{{ c.quote }}"</blockquote>
        {% endif %}
        <footer class="komentari-foot">
          {% if c.source_url %}<a href="{{ c.source_url | safe_url }}" target="_blank" rel="nofollow noopener" class="komentari-source">Avots →</a>{% endif %}
        </footer>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p style="color:var(--text-muted);">Nav saglabātu komentāru.</p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Publikācijas tab (žurnālistu/analītiķu X+Ziņas merge) -->
  {% if 'publikacijas' in tab_set %}
  <div class="profile-tab" id="tab-publikacijas" role="tabpanel" aria-labelledby="tab-btn-publikacijas"{% if default_tab != 'publikacijas' %} style="display:none;"{% endif %}>
    {% if own_pubs %}
    <h2 style="font-size:1rem; color:var(--text-muted);">Publikācijas vietnē {{ own_pubs_outlet.host }} ({{ own_pubs|length }}{% if pub_totals.own > own_pubs|length %} jaunākās no {{ pub_totals.own }}{% endif %})</h2>
    {% for n in own_pubs %}
    <div class="card profile-feed-card">
      <div class="profile-feed-meta">
        <span>{{ n.source_domain or '' }}</span>
        <span>{{ (n.published_at or n.scraped_at)[:10] if (n.published_at or n.scraped_at) else '' }}</span>
      </div>
      <div class="profile-feed-body">{{ n.preview }}{% if n.preview and n.preview|length >= 200 %}…{% endif %}</div>
      {% if n.source_url %}<a href="{{ n.source_url | safe_url }}" target="_blank" rel="noopener" class="profile-feed-link">Lasīt pilnu rakstu ↗</a>{% endif %}
    </div>
    {% endfor %}
    {% if own_pubs_outlet %}
    <a href="../mediji/{{ own_pubs_outlet.slug }}.html" style="font-size:0.85rem;">Visas medija publikācijas →</a>
    {% endif %}
    {% endif %}{% if x_posts %}
    <h2 style="{% if own_pubs %}margin-top:1.5rem; {% endif %}font-size:1rem; color:var(--text-muted);">X ieraksti ({{ x_posts|length }}{% if pub_totals.x > x_posts|length %} jaunākie no {{ pub_totals.x }}{% endif %})</h2>
    {% for p in x_posts %}
    <div class="card profile-feed-card">
      <div class="profile-feed-meta">
        <span>{{ p.source_domain or 'x.com' }}</span>
        <span>{{ (p.published_at or p.scraped_at)[:10] if (p.published_at or p.scraped_at) else '' }}</span>
      </div>
      <div class="profile-feed-body profile-feed-body-x">{{ p.content[:280] }}{% if p.content and p.content|length > 280 %}…{% endif %}</div>
      {% if p.source_url %}<a href="{{ p.source_url | safe_url }}" target="_blank" rel="noopener" class="profile-feed-link">Atvērt X ↗</a>{% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if news %}
    <h2 style="margin-top:1.5rem; font-size:1rem; color:var(--text-muted);">{% if politician.profile_kind == 'organization' %}Pieminēts medijos ({{ news|length }}{% if pub_totals.news > news|length %} no {{ pub_totals.news }}{% endif %}){% else %}Ziņas ({{ news|length }}{% if pub_totals.news > news|length %} no {{ pub_totals.news }}{% endif %}){% endif %}</h2>
    {% for n in news %}
    <div class="card profile-feed-card">
      <div class="profile-feed-meta">
        <span>{{ n.source_domain or '' }}{% if n.role == 'mentioned' %} <span class="muted-tag">pieminēts</span>{% endif %}</span>
        <span>{{ n.scraped_at[:10] if n.scraped_at else '' }}</span>
      </div>
      <div class="profile-feed-body">{{ n.preview }}{% if n.preview and n.preview|length >= 200 %}…{% endif %}</div>
      {% if n.source_url %}<a href="{{ n.source_url | safe_url }}" target="_blank" rel="noopener" class="profile-feed-link">Lasīt pilnu rakstu ↗</a>{% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if not x_posts and not news and not own_pubs %}
    <p style="color:var(--text-muted);">Nav publikāciju.</p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Saites tab (mini-graf + 3 type-color sekcijas + commentary + vote alignment) -->
  {% if 'saites' in tab_set %}
  <div class="profile-tab" id="tab-saites" role="tabpanel" aria-labelledby="tab-btn-saites"{% if default_tab != 'saites' %} style="display:none;"{% endif %}>
    {% if saites_data.mini_graph.neighbors %}
    {% set party_color = (party_meta.color if party_meta and party_meta.color else '#8b8fa3') %}
    <svg viewBox="0 0 400 280" class="mini-saites-graph" role="img" aria-label="Saišu mini-grafs">
      {# Connecting lines first so neighbor circles render on top #}
      {% for n in saites_data.mini_graph.neighbors %}
      <line x1="200" y1="140" x2="{{ n.x }}" y2="{{ n.y }}"
            class="saites-link saites-link-{{ n.tension_type }}" stroke-width="2"/>
      {% endfor %}
      {# Center node — this politician #}
      <circle cx="200" cy="140" r="14" fill="{{ party_color }}" stroke-width="2" class="saites-node"/>
      {# Uzvārds, ne priekšvārds — "Jānis" starp 40 Jāņiem neko nepasaka (UX review 2026-07-26). #}
      <text x="200" y="170" text-anchor="middle" font-size="10" fill="var(--text-muted)">{{ politician.name.split()[-1] }}</text>
      {# Neighbors — klikšķis aizved uz attiecīgo saites kartiņu zem grafa, ne uz cita profila lapu (B-lite). #}
      {% for n in saites_data.mini_graph.neighbors %}
      <a xlink:href="#saites-{{ n.pid }}" aria-label="{{ n.name }} ({{ n.tension_type }}) — skatīt detaļas">
        <circle cx="{{ n.x }}" cy="{{ n.y }}" r="9" fill="{{ n.party_color }}" stroke-width="1.5" class="saites-node"/>
        <title>{{ n.name }} ({{ n.tension_type }})</title>
      </a>
      <text x="{{ n.x }}" y="{{ n.y + 22 }}" text-anchor="middle" font-size="9"
            fill="var(--text-muted)" class="saites-node-label">{{ n.name.split()[-1] }}</text>
      {% endfor %}
    </svg>
    {% endif %}

    {% if saites_data.tensions_total is defined and saites_data.tensions_total > saites_data.tensions_shown %}
    <p class="pp-muted">Rādīti jaunākie {{ saites_data.tensions_shown }} no {{ saites_data.tensions_total }} uzbrukumu, spriedžu un atbalsta ierakstiem. Visi — <a href="../saites.html">saišu kartē</a>.</p>
    {% endif %}

    {% if saites_data.uzbrukumi %}
    <div class="saites-section saites-section-uzbrukumi">
      <h4>Uzbrukumi ({{ saites_data.uzbrukumi|length }})</h4>
      {% for t in saites_data.uzbrukumi %}
      <div class="card saites-card{% if t.is_anchor %} saites-card-anchor{% endif %}"
           {% if t.is_anchor %}id="saites-{{ t.other_pid }}"{% endif %}
           style="margin-bottom:0.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <strong>{{ t.source_name }}</strong> → <strong>{{ t.target_name }}</strong>
          <span style="color:var(--text-muted); font-size:0.8rem;">{{ t.created_at[:10] if t.created_at else '' }}</span>
        </div>
        {% if t.topic %}<span class="topic-tag">{{ t.topic }}</span>{% endif %}
        <div style="margin-top:0.4rem; font-size:0.9rem;">{{ t.description }}</div>
        {% if t.source_url %}<a href="{{ t.source_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem;">Avots ↗</a>{% endif %}
        {% if t.target_url %}<a href="{{ t.target_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem; margin-left:0.5rem;">Atbilde ↗</a>{% endif %}
        {% if t.other_slug %}<a href="../politiki/{{ t.other_slug }}.html" class="saites-card-profile-btn" style="font-size:0.8rem; margin-left:0.5rem;">Skatīt profilu →</a>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if saites_data.spriedzes %}
    <div class="saites-section saites-section-spriedzes">
      <h4>Spriedzes ({{ saites_data.spriedzes|length }})</h4>
      {% for t in saites_data.spriedzes %}
      <div class="card saites-card{% if t.is_anchor %} saites-card-anchor{% endif %}"
           {% if t.is_anchor %}id="saites-{{ t.other_pid }}"{% endif %}
           style="margin-bottom:0.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <strong>{{ t.source_name }}</strong> → <strong>{{ t.target_name }}</strong>
          <span style="color:var(--text-muted); font-size:0.8rem;">{{ t.created_at[:10] if t.created_at else '' }}</span>
        </div>
        {% if t.topic %}<span class="topic-tag">{{ t.topic }}</span>{% endif %}
        <div style="margin-top:0.4rem; font-size:0.9rem;">{{ t.description }}</div>
        {% if t.source_url %}<a href="{{ t.source_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem;">Avots ↗</a>{% endif %}
        {% if t.target_url %}<a href="{{ t.target_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem; margin-left:0.5rem;">Atbilde ↗</a>{% endif %}
        {% if t.other_slug %}<a href="../politiki/{{ t.other_slug }}.html" class="saites-card-profile-btn" style="font-size:0.8rem; margin-left:0.5rem;">Skatīt profilu →</a>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if saites_data.atbalsts %}
    <div class="saites-section saites-section-atbalsts">
      <h4>Atbalsts ({{ saites_data.atbalsts|length }})</h4>
      {% for t in saites_data.atbalsts %}
      <div class="card saites-card{% if t.is_anchor %} saites-card-anchor{% endif %}"
           {% if t.is_anchor %}id="saites-{{ t.other_pid }}"{% endif %}
           style="margin-bottom:0.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <strong>{{ t.source_name }}</strong> → <strong>{{ t.target_name }}</strong>
          <span style="color:var(--text-muted); font-size:0.8rem;">{{ t.created_at[:10] if t.created_at else '' }}</span>
        </div>
        {% if t.topic %}<span class="topic-tag">{{ t.topic }}</span>{% endif %}
        <div style="margin-top:0.4rem; font-size:0.9rem;">{{ t.description }}</div>
        {% if t.source_url %}<a href="{{ t.source_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem;">Avots ↗</a>{% endif %}
        {% if t.target_url %}<a href="{{ t.target_url | safe_url }}" target="_blank" rel="noopener" style="font-size:0.8rem; margin-left:0.5rem;">Atbilde ↗</a>{% endif %}
        {% if t.other_slug %}<a href="../politiki/{{ t.other_slug }}.html" class="saites-card-profile-btn" style="font-size:0.8rem; margin-left:0.5rem;">Skatīt profilu →</a>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if saites_data.commentary_about %}
    <div class="saites-section saites-section-commentary">
      <h4>Komentāri par {{ politician.name }} ({{ saites_data.commentary_about|length }})</h4>
      {% for c in saites_data.commentary_about %}
      <div class="card" style="margin-bottom:0.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <span>
            {% if c.speaker_handle %}<a href="https://x.com/{{ c.speaker_handle }}" target="_blank" rel="noopener">@{{ c.speaker_handle }}</a>
            {% else %}{{ c.speaker_name }}{% endif %}
          </span>
          <span style="color:var(--text-muted); font-size:0.8rem;">{{ c.stated_at[:10] if c.stated_at else c.created_at[:10] }}</span>
        </div>
        {% if c.topic %}<span class="topic-tag">{{ c.topic }}</span>{% endif %}
        <p style="margin-top:0.4rem; font-size:0.9rem;">{{ c.stance }}</p>
        {% if c.source_url %}<a href="{{ c.source_url | safe_url }}" target="_blank" rel="nofollow noopener" style="font-size:0.8rem;">Avots →</a>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if saites_data.vote_alignment_top %}
    <div class="saites-section saites-section-alignment">
      <h4>Visbiežāk balso vienādi</h4>
      <ul class="alignment-list">
        {% for v in saites_data.vote_alignment_top %}
        <li><a href="../politiki/{{ v.slug }}.html">{{ v.name }}</a>{% if v.party %} <span style="color:var(--text-muted); font-size:0.8rem;">({{ v.party }})</span>{% endif %} — <strong>{{ v.agree_pct }}%</strong> sakritība ({{ v.agree }}/{{ v.total }})</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if saites_data.vote_alignment_bottom %}
    <div class="saites-section saites-section-alignment">
      <h4>Visretāk balso vienādi</h4>
      <ul class="alignment-list">
        {% for v in saites_data.vote_alignment_bottom %}
        <li><a href="../politiki/{{ v.slug }}.html">{{ v.name }}</a>{% if v.party %} <span style="color:var(--text-muted); font-size:0.8rem;">({{ v.party }})</span>{% endif %} — <strong>{{ v.agree_pct }}%</strong> sakritība ({{ v.agree }}/{{ v.total }})</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if not saites_data.uzbrukumi and not saites_data.spriedzes and not saites_data.atbalsts and not saites_data.commentary_about and not saites_data.vote_alignment_top %}
    <p style="color:var(--text-muted);">Nav saišu datu.</p>
    {% endif %}

    <a href="../saites.html" class="see-full-graph-link" style="display:inline-block; margin-top:1rem; font-size:0.9rem;">Skatīt pilnajā kartē →</a>
  </div>
  {% endif %}

  <!-- Deklarācijas tab (VAD amatpersonu deklarācijas — year selector + 9 sekciju akkordeoni ar delta) -->
  {% if 'deklaracijas' in tab_set %}
  <div class="profile-tab" id="tab-deklaracijas" role="tabpanel" aria-labelledby="tab-btn-deklaracijas"{% if default_tab != 'deklaracijas' %} style="display:none;"{% endif %}>
    {% include "_vad_panel.html.j2" %}
  </div>
  {% endif %}

  {# wiki_profile is rendered INSIDE the Pārskats tab; profiles without
     Pārskats get it BELOW all tab panels — starp cilņu joslu un paneli nekas
     nemainīgs nestāv (telefonā saturs uzreiz zem cilnēm, 2026-10-07).
     Saistītās sintēzes VISIEM profiliem pašā apakšā virs «Turpini rakt»
     (operators 2026-10-07). #}
  {% if 'parskats' not in tab_set and wiki_profile %}
  <div class="wiki-profile post-content">
    {{ wiki_profile | safe }}
  </div>
  {% endif %}

  {% if syntheses %}
  <div class="related-syntheses pp-syntheses">
    <h2 class="pp-kicker">Saistītās sintēzes</h2>
    <div class="pp-syntheses-list">
      {% for s in syntheses %}
      <a href="../sintezes/{{ s.slug }}.html" class="card synthesis-card">
        {% if s.image_filename %}
        <img src="../images/synthesis/{{ s.image_filename|image_variant('thumb') }}" alt="" loading="lazy" decoding="async" width="96" height="54" class="synthesis-card-thumb">
        {% endif %}
        <div class="synthesis-card-text">
          <div class="synthesis-card-title">{{ s.title }}</div>
          {% if s.description %}<div class="synthesis-card-desc">{{ s.description }}</div>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>

{% include "_keep_digging.html.j2" %}
{% endblock %}

{% block scripts %}
{# Pieejamo cilņu kopa — JSON-emitēta no tab_set (saglabā secību), ļauj
   ppv1.js veikt URL hash validāciju. Non-executable script tips → CSP-atļauts. #}
<script type="application/json" id="profile-tabs">{{ tab_set | tojson | safe_json }}</script>
<script src="{{ assets_prefix }}assets/ppv1.js?v={{ assets_version }}" defer></script>
{% endblock %}
