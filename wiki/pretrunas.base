formulas:
  karogs: if(contradictions > 0, "⚠️", "")
properties:
  party:
    displayName: Partija
  role:
    displayName: Loma
  contradictions:
    displayName: Pretrunas
  positions:
    displayName: Pozīcijas
  mentioned_in:
    displayName: Pieminēts
  members:
    displayName: Deputāti
  formula.karogs:
    displayName: ""
views:
  - type: table
    name: Politiķi ar pretrunām
    filters:
      and:
        - file.inFolder("persons")
        - relationship_type == "tracked"
        - contradictions > 0
    order:
      - formula.karogs
      - file.name
      - party
      - contradictions
      - positions
      - mentioned_in
    sort:
      - property: contradictions
        direction: DESC
  - type: table
    name: Partijas ar pretrunām
    filters:
      and:
        - file.inFolder("parties")
        - contradictions > 0
    order:
      - formula.karogs
      - file.name
      - members
      - contradictions
    sort:
      - property: contradictions
        direction: DESC
