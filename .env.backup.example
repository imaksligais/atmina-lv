# Nokopē uz .env.backup un aizpildi. .env.backup ir gitignorēts.
# Lieto scripts/backup_db.py (ārējā DB kopija reizi nedēļā,
# wiki/operations/db-snapshots.md § «Ārējā kopija (reizi nedēļā)»).

# Galamērķis: local:<mape>  vai  ssh:<ssh-host-alias>:<attālā mape>
#   local: — cits fizisks disks šajā datorā (NE repo kokā; skripts to atsaka).
#   ssh:   — host alias no ~/.ssh/config; mape ārpus publiskās tīmekļa saknes
#            (ceļu ar public_html skripts atsaka). Piemērs: ssh:backup-host:atmina-backups
BACKUP_DEST=local:D:/atmina-backups

# Fails ar gpg paroles frāzi — ĀRPUS repo. Frāzi glabā ARĪ paroļu pārvaldniekā:
# bez tās kopija nav atšifrējama, ja šis disks nomirst.
BACKUP_PASSPHRASE_FILE=/path/outside/repo/backup-passphrase.txt

# Cik jaunāko kopiju (datumu) paturēt galamērķī.
BACKUP_KEEP=4
